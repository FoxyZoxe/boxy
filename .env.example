# == IA ==============================================================
# Moteur IA : groq (gratuit) | ollama (local) | openai (payant)
AI_PROVIDER=groq

# Groq -- GRATUIT, sans CB (console.groq.com > API Keys)
GROQ_API_KEY=VOTRE_CLE_GROQ_ICI
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama -- IA 100% locale (ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# OpenAI -- (platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# == PERSONNALITE ====================================================
ASSISTANT_NAME=Boxy
USER_NAME=Monsieur
MAX_HISTORY_LENGTH=6
AI_TIMEOUT=120

# == VOIX ===========================================================
VOICE_ENABLED=true
TTS_VOICE=fr-FR-DeniseNeural
WHISPER_MODEL=small
STT_LANGUAGE=fr
VOICE_MODE=wake_word
PTT_KEY=space
WAKE_WORD_MODEL=hey_jarvis
GLOBAL_HOTKEY=ctrl+space
PICOVOICE_ACCESS_KEY=

# == INTERFACE ======================================================
THEME=cyan

# == OPTIONS ========================================================
IMAGE_PROVIDER=pollinations

# == INTEGRATIONS (optionnel) =======================================
DISCORD_TOKEN=
DISCORD_CHANNEL=boxy
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
HF_HUB_DISABLE_SYMLINKS_WARNING=1
